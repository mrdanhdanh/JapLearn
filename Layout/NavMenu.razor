        <div class="nav-item px-3">
            <NavLink class="nav-link" href="learn-kana">
                <span class="bi bi-book-fill-nav-menu" aria-hidden="true"></span> Học bảng chữ cái
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="learn-words">
                <span class="bi bi-book-fill-nav-menu" aria-hidden="true"></span> Học từ vựng
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="quiz-words">
                <span class="bi bi-question-circle-fill-nav-menu" aria-hidden="true"></span> Trắc nghiệm
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="learn-kanji">
                <span class="bi bi-pencil-square-fill-nav-menu" aria-hidden="true"></span> Học Kanji
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
